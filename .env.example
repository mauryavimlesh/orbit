# ORBIT — Multi-Source Research Engine & AI Configuration
# Optional API Keys for Higher Rate Limits (All public providers work out-of-the-box without keys)
# Configure secrets in AI Studio Settings -> Secrets

# Gemini API Key (Automatically injected by AI Studio runtime)
# GEMINI_API_KEY=

# Polite Email for OpenAlex, Crossref, Europe PMC, and NCBI Entrez E-Utilities
# USER_EMAIL=researcher@example.com

# Optional Provider API Keys for Elevated Rate Limits
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=
# CORE_API_KEY=
# GITHUB_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=
